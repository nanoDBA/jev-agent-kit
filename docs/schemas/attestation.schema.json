{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoDBA/jev_agent_kit/schemas/attestation.schema.json",
  "title": "Live-use attestation",
  "type": "object",
  "required": [
    "inventory",
    "inventory_date",
    "dpa"
  ],
  "additionalProperties": false,
  "properties": {
    "inventory": {
      "type": "boolean"
    },
    "inventory_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dpa": {
      "type": "boolean"
    },
    "dpa_date": {
      "type": "string"
    }
  }
}
