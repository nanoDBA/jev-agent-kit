{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoDBA/jev_agent_kit/schemas/outcome.schema.json",
  "title": "Outcome line",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "decision_id",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "outcome"
    },
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "applied",
        "not_applied",
        "overridden_by_host",
        "overridden_by_human"
      ]
    },
    "action_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
