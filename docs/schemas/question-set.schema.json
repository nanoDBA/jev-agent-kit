{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nanoDBA/jev-agent-kit/schemas/question-set.schema.json",
  "title": "Jev question set",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "model",
    "escalation_target",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {},
    "model": {
      "type": "string",
      "pattern": "^jev-[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "escalation_target": {
      "type": "string",
      "minLength": 1
    },
    "excluded_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transcripts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "cap": {
          "type": "integer"
        }
      }
    },
    "state_schema": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "log_templates": {
      "description": "ADR 0004: declared log templates. A log field opts in with params.format = \"template\" and then accepts only records {level, template_id, params}.",
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Literal text with {slot} placeholders; each declared slot exactly once."
          },
          "params": {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "identifier",
                        "contact",
                        "path",
                        "command",
                        "metric"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "values"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "enum"
                    },
                    "values": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "questions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "instructions",
          "kit"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "noul",
              "choice",
              "score"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "description": "choice: option->description map; score: ordered array of level strings; noul: optional {true,false}"
          },
          "kit": {
            "type": "object",
            "required": [
              "consequence"
            ],
            "properties": {
              "consequence": {
                "enum": [
                  "gate",
                  "advisory"
                ]
              }
            }
          }
        }
      }
    }
  }
}
