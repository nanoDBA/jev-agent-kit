{
  "schema_version": 1,
  "id": "postflight-verify",
  "version": "2",
  "model": "jev-1.13.0",
  "escalation_target": "human-review",
  "state_schema": {
    "request": {
      "kind": "free_text",
      "params": {
        "source_type": "agent_request"
      }
    },
    "output": {
      "kind": "free_text",
      "params": {
        "source_type": "agent_output"
      }
    }
  },
  "questions": {
    "addresses_request": {
      "type": "noul",
      "instructions": "Does `output` address what `request` asked for?",
      "kit": {
        "consequence": "advisory"
      }
    },
    "contains_citation": {
      "type": "noul",
      "instructions": "Does `output` cite or reference a source, such as a URL, paper, book, document, dataset, or a quotation attributed to someone? Answer only whether a citation is present, not whether it is accurate.",
      "kit": {
        "consequence": "advisory"
      }
    },
    "within_scope": {
      "type": "noul",
      "instructions": "Does `output` stay within what was asked, without unrequested actions or claims?",
      "kit": {
        "consequence": "advisory"
      }
    }
  }
}
